  <slab id="north-sidewalk" profile="north-walk-plan" elevation="0.18" thickness="0.5" material="builtin:concrete"/>

  <!-- Lower plaza, kinked tiled passage and western two-flight climb. -->
  <profile id="plaza-plan" points="-5 4.1; 9 4.1; 9 7.6; 10.7 7.6; 10.7 12; 7.6 12; 7.6 10.2; -8.9 10.2; -8.9 6.85; -11.1 6.85; -11.1 5.8; -5 5.8"/>
