  <!-- Service road and curb sidewalks. -->
  <profile id="road-plan" points="-18 -4; 20 -4; 20 2; -18 2"/>
  <profile id="south-walk-plan" points="-18 -6.6; 20 -6.6; 20 -4; -18 -4"/>
  <profile id="north-walk-plan" points="-18 2; 20 2; 20 4.1; -18 4.1"/>
