  <material id="stair-rail-rust" color="#aa885e" repeat="4.2" roughness="1" metalness="1" texture="textures/stair-rail-hardware.png" normal-texture="textures/stair-rail-hardware-normal.png" metallic-roughness-texture="textures/stair-rail-hardware-properties.png" normal-scale="0.85"/>
