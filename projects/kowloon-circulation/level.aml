  <material id="stair-edge" color="#a5ac99" repeat="1.14" roughness="1" texture="textures/stair-concrete.png" normal-texture="textures/stair-concrete-normal.png" metallic-roughness-texture="textures/stair-concrete-properties.png" normal-scale="0.9"/>
  <material id="stair-edge-repair" color="#bfa985" repeat="1.14" roughness="1" texture="textures/stair-concrete.png" normal-texture="textures/stair-concrete-normal.png" metallic-roughness-texture="textures/stair-concrete-properties.png" normal-scale="0.75"/>
  <material id="stair-tile-edge" color="#c4b892" repeat="1.07" roughness="1" texture="textures/stair-concrete.png" normal-texture="textures/stair-concrete-normal.png" metallic-roughness-texture="textures/stair-concrete-properties.png" normal-scale="0.59"/>
