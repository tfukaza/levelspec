  <landing id="alley-turn" profile="alley-turn-plan" elevation="1.08" thickness="1.3" material="stair-concrete"/>
  <stairs id="alley-upper" path="alley-upper-axis" width="2.2" count="5" thickness="0.30" underside="sloped" material="builtin:concrete"/>
  <landing id="upper-terrace" profile="terrace-plan" elevation="1.8" thickness="2.1" material="builtin:concrete"/>

  <!-- Sloping west lane rejoins the same plaza. The offset bend uses paired rails. -->
  <path id="ramp-south" points="-16 4.1 1.8; -11 4.1 1.03; -7.2 4.1 0.46; -5 4.1 0.18"/>
  <path id="ramp-north" points="-16 5.8 1.8; -11 5.95 1.03; -7.2 5.85 0.46; -5 5.8 0.18"/>
